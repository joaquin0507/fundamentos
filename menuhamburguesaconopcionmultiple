
#include <iostream>
using namespace std;
int main()
{
  
    int ph=0,ph2=0,pp=0,ps=0,a,b;
    double cparcial,tph=0,tph2=0,tpp=0,tps=0;
    cout<<"            menu";
    cout<<"\n1.-hamburguesa...............3bs";
    cout<<"\n2.-hamburguesa con queso.....5bs";
    cout<<"\n3.-papas fritas...........2,50bs";
    cout<<"\n4.-soda......................3bs";
    cout<<"\n0.-salir";

 
 
   do{
      cout<<"\ningrese el numero del producto que desea comprar:";
      cin >>a;
        switch (a){
            case 1:
                do{
                 cout<<"cuantas hamburguesas desea?: ";cin>>b;
                }while(b<0);
             ph=ph+b;
             cparcial=b*3;
             tph=tph+cparcial;
             break;
            case 2:
                do{
                 cout<<"cuantas hamburguesas con queso desea?: ";cin>>b;
                }while(b<0);
             ph2=ph2+b;
             cparcial=b*5;
             tph2=tph2+cparcial;
             break;
            case 3:
                do{
                  cout<<"cuantas papas desea?: ";cin>>b;
                }while(b<0);
             pp=pp+b;
             cparcial=b*2.5;
             tpp=tpp+cparcial;
             break;
            case 4:
                do{
                  cout<<"cuantas sodas desea?: ";cin>>b;
                }while(b<0);
             ps=ps+b;
             cparcial=b*3;
             tps=tps+cparcial;
             break;
            case 0:
             cout <<"salir";
            default:
             cout<<"opcion invalida";
        }
    }while (a!=0);
    b=ph+ph2+pp+ps;
    cparcial=tph+tph2+tpp+tps;
    cout<<"\nITEM                      CANTIDAD      P. UNITARIO";
    cout<<"\nhamburguesa                 "<<ph<<"\t        "<<tph;
    cout<<"\nhamburguesa con queso       "<<ph2<<"\t        "<<tph2;
    cout<<"\npapas fritas                "<<pp<<"\t        "<<tpp;
    cout<<"\nsoda                        "<<ps<<"\t        "<<tps;
    cout<<"\nTOTAL                       "<<b<<"\t        "<<cparcial;
    return 0;
}
