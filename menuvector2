}

void cargar(int a[], int tam) 
{
    for (int i = 0; i < tam; i++) {
        cout << "v[" << i << "]=";
        cin >> a[i];
    }




}
void mostrar(int a[], int tam) 
{
    for (int i = 0; i < tam; i++) {
        cout << "v[" << i << "]=";
        cout << a[i] << endl;
    }

}
void burbuja(int a[], int tam) 
{
    for (int i = 0; i < tam; i++) {
        for (int j = 0; j < tam; j++) {
            if (a[i] < a[j]) {
                int aux;
                aux = a[i];
                a[i] = a[j];
                a[j] = aux;
            }
        }
    }

}

void mv(int a[], int mayor)
{
     for (int i = 0; i < mayor; i++)
     {
            if (a[i] > mayor)
                mayor = a[i];
     }
     cout<<mayor;
    
}
