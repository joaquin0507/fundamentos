#include <iostream>
#include <math.h>

using namespace std;
int main()
{
   float x1,x2,x3,y1,y2,y3;
   float a,x,y,r;
   cout<<"intrudir primera coordenada (x1,y1): "<<endl;
   cin>>x1;
   cin>>y1;
   cout<<"intrudir primera coordenada (x2,y2): "<<endl;
   cin>>x2;
   cin>>y2;
   cout<<"intrudir primera coordenada (x3,y3): "<<endl;
   cin>>x3;
   cin>>y3;
   a=2*(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y3));
   if(a==0){
     cout<<"los puntos son colineales, no se puede proseguir";
   }else{
     x=((x1*x1+y1*y1)*(y2-y3)+(x2*x2+y2*y2)*(y3-y1)+(x3*x3+y3*y3)*(y1-y2))/a;
     y=((x1*x1+y1*y1)*(x2-x3)+(x2*x2+y2*y2)*(x3-x1)+(x3*x3+y3*y3)*(x1-x2))/a;
     r=sqrt((x-x1)*(x-x1)+(y-y1)*(y-y1));
     cout<<"el centro es: "<<x<<","<<y;
     cout<<"el radio es:"<<r;
    }
    return 0;
}
