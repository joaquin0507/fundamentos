#include <iostream>
#define MAX 100
using namespace std;
void cargar(int a[], int tam);
void mostrar(int a[], int tam);

void mv(int a[], int mayor);
void burbuja(int a[], int tam);
int main()
{
    int opcion,n,v[MAX];
    do 
    {
        cout << "\nmenu" << endl;
        cout << "1.-cargar" << endl;
        cout << "2.-mostrar" << endl;
        cout << "3.-clasificar" << endl;
        cout << "4.-mayor valor" << endl;
        cout << "0.-salir" <<endl;
        cout << "elija una opcion:"<<endl;
        cin >> opcion;
        switch (opcion) 
        {
            case 1:

                do {
                    cout << "cuantos elementos quiere";
                    cin >> n;
                } while (n > MAX  || n < 0);
                cargar(v, n);
                break;
            case 2:
                mostrar(v, n);
                break;
            case 3:
                burbuja(v, n);
                break;
            case 4:
                mv(v, n);
                break;
            case 0:
                cout << "saliendo...";
                break;
            default:
